{
  "name": "yaya_msg",
  "version": "2.12.0",
  "description": "牙牙消息",
  "homepage": "https://github.com/yk1z/yaya_msg",
  "main": "main.js",
  "scripts": {
    "database:build": "node scripts/build-web.js --database-runtime-only",
    "start": "npm run database:build && electron .",
    "web:build": "node scripts/build-web.js",
    "web:dev": "npm run web:build && npx wrangler dev",
    "web:dev:lan": "npm run web:build && npx wrangler dev --ip 0.0.0.0 --port 8787",
    "web:deploy": "npm run web:build && npx wrangler deploy",
    "api:start": "node server/yaya-api.mjs",
    "search:start": "node server/search-api.mjs",
    "pack": "npm run database:build && node scripts/run-builder.js --dir",
    "dist": "npm run database:build && node scripts/run-builder.js",
    "seine:export-all": "node scripts/export-all-member-channels.js",
    "seine:compare": "node scripts/compare-member-channels.js",
    "seine:compare-members": "python scripts/compare-member-profiles.py",
    "seine:export-compare": "npm run seine:export-all && npm run seine:compare && npm run seine:compare-members",
    "music:metadata:local": "node scripts/build-r2-music-track-metadata.mjs",
    "music:metadata:remote": "node scripts/build-r2-music-track-metadata-from-api.mjs"
  },
  "author": {
    "name": "yk1z",
    "email": "yk1z@users.noreply.github.com"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "axios": "^1.19.0",
    "fluent-ffmpeg": "^2.1.3",
    "node-media-server": "^4.2.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@ffmpeg/core": "0.11.0",
    "@ffmpeg/ffmpeg": "0.11.6",
    "@yxim/nim-web-sdk": "9.21.14",
    "artplayer": "5.4.0",
    "artplayer-plugin-danmuku": "5.3.0",
    "dplayer": "1.27.1",
    "electron": "41.10.4",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "ffmpeg-static": "5.3.0",
    "hls.js": "1.6.16",
    "lucide-react": "0.292.0",
    "mpegts.js": "1.8.0",
    "pinyin-pro": "3.28.2",
    "postcss": "8.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.19",
    "wrangler": "^4.118.0"
  },
  "build": {
    "appId": "com.yaya.message",
    "productName": "牙牙消息",
    "executableName": "牙牙消息",
    "afterPack": "scripts/copy-ffmpeg.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "index.html",
      "style.css",
      "icon.png",
      "icon.ico",
      "rust-wasm.js",
      "rust-wasm-browser.js",
      "node_modules/**/*",
      "!node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      "2.wasm"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "icon": "icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "category": "Utility",
      "maintainer": "yk1z <yk1z@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "Name": "牙牙消息",
          "Icon": "yaya_msg",
          "StartupWMClass": "yaya_msg"
        }
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
